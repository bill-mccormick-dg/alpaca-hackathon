# {{ ansible_managed }}
# Home Assistant YAML-mode dashboard for the alpaca-hackathon bot(s).
# Entities come from two publishers: bot/mqtt.py (the read-only state
# sensors, published by run_cycle.py each cycle) and mqtt_bridge.py (the
# kill-switch button + tunable-knob controls, published once at bridge
# startup - see mqtt_bridge.py's discovery_payloads()). Rows, each one a
# horizontal-stack with one column per account in ha_accounts: 1 kill
# switches, 2 state, 3 Day P&L history, 4 tunable knobs. Every card
# carries its account's label, so there is no separate heading row and no
# intro blurb - the sidebar title already says what this dashboard is.
# The cross-account equity comparison chart is deliberately left off.
#
# Entity ids: HA derives entity_id from device+entity name and ignores
# object_id, so these must match bot/mqtt.py's ENTITY_PREFIX scheme
# (<prefix>_<account>_<key>). ha_entity_prefix exists to keep the two in
# step if the device name ever changes.
title: {{ ha_dashboard_title }}
views:
  - title: Trading
    path: {{ ha_dashboard_url_path }}
    icon: {{ ha_dashboard_icon }}
    type: panel
    cards:
      - type: vertical-stack
        cards:
          # Kill switches come first so they're always reachable in an
          # emergency without scrolling past state cards. Each tile names
          # its own account.
          #
          # The control is a SWITCH (mqtt_bridge.py publishes it as one), so
          # it shows the account's real halt state rather than being a
          # stateless press. A tile's `color` only applies while the entity
          # is active, and YAML-mode Lovelace has no templated colour, so the
          # green/red pair is done with two mutually-exclusive conditional
          # cards - exactly one renders. They live in a vertical-stack per
          # account so the hidden one can't collapse the row's columns.
          #
          # Each halts ONLY its own account; the global "halt everything" is
          # CLI-only by design (flatten.py --halt --all-accounts), so nothing
          # here can stop the judged account.
          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  # Trading (switch off) -> GREEN. Tap halts, with a confirm.
                  - type: conditional
                    conditions:
                      - condition: state
                        entity: switch.{{ ha_entity_prefix }}_{{ acct.id }}_kill_switch
                        state: "off"
                    card:
                      type: tile
                      entity: switch.{{ ha_entity_prefix }}_{{ acct.id }}_kill_switch
                      name: {{ acct.label }} — trading
                      icon: mdi:play-circle
                      color: green
                      hide_state: true
                      tap_action:
                        action: toggle
                        confirmation:
                          text: >-
                            Flatten {{ acct.label }}'s positions and halt
                            {{ acct.label }}? Other accounts keep trading.
                  # Halted (switch on) -> RED. Tap resumes, with a confirm.
                  # A daily-loss or global halt also shows red here, but the
                  # bridge refuses to clear those from the dashboard and
                  # republishes the real state, so the tile stays red.
                  - type: conditional
                    conditions:
                      - condition: state
                        entity: switch.{{ ha_entity_prefix }}_{{ acct.id }}_kill_switch
                        state: "on"
                    card:
                      type: tile
                      entity: switch.{{ ha_entity_prefix }}_{{ acct.id }}_kill_switch
                      name: {{ acct.label }} — HALTED
                      icon: mdi:stop-circle
                      color: red
                      hide_state: true
                      tap_action:
                        action: toggle
                        confirmation:
                          text: >-
                            Resume trading on {{ acct.label }}? This only
                            clears a manual halt - a daily-loss or global
                            halt still has to be cleared on the host.
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: entities
                title: {{ acct.label }} — state
                icon: mdi:robot
                entities:
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_equity
                        name: Equity
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_day_pnl
                        name: Day P&L
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_positions
                        name: Open positions
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_halt
                        name: Halt state
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_last_decision
                        name: Last decision
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: history-graph
                title: {{ acct.label }} — Day P&L
                hours_to_show: 24
                entities:
                  - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_day_pnl
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: entities
                title: {{ acct.label }} — controls
                entities:
                  - entity: text.{{ ha_entity_prefix }}_{{ acct.id }}_model
                    name: Model
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_temperature
                    name: Temperature
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_max_tokens
                    name: Max tokens
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_research_contracts_per_underlying
                    name: Research contracts/underlying
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_option_strike_band_pct
                    name: Strike band %
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_stop_loss_pct
                    name: Stop loss %
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_take_profit_pct
                    name: Take profit %
                  - entity: number.{{ ha_entity_prefix }}_{{ acct.id }}_eod_close_dte
                    name: EOD close DTE
{% endfor %}
