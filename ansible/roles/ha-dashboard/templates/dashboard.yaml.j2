# {{ ansible_managed }}
# Home Assistant YAML-mode dashboard for the alpaca-hackathon bot(s).
# Entities come from two publishers: bot/mqtt.py (the read-only state
# sensors, published by run_cycle.py each cycle) and mqtt_bridge.py (the
# kill-switch button + tunable-knob controls, published once at bridge
# startup - see mqtt_bridge.py's discovery_payloads()). Rows, each one a
# horizontal-stack with one column per account in ha_accounts: 1 intro
# (full width), 2 kill switches, 3 State, 4 Day P&L history, 5 tunable
# knobs. The cross-account equity comparison chart is deliberately left
# off for now.
title: {{ ha_dashboard_title }}
views:
  - title: Trading
    path: {{ ha_dashboard_url_path }}
    icon: {{ ha_dashboard_icon }}
    type: panel
    cards:
      - type: vertical-stack
        cards:
          - type: markdown
            content: >
              Long Premium, Short Leash — deterministic risk gates, an
              open-source model proposes, code disposes. Source:
              [alpaca-hackathon](https://github.com/bill-mccormick-dg/alpaca-hackathon).

          # Kill switches sit directly under the title so they're always the
          # first thing reachable in an emergency, without scrolling past the
          # state cards. Each tile names its own account, since this row sits
          # above the per-account headings below.
          #
          # The control is a SWITCH (mqtt_bridge.py publishes it as one), so
          # it shows the account's real halt state rather than being a
          # stateless press. A tile's `color` only applies while the entity
          # is active, and YAML-mode Lovelace has no templated colour, so the
          # green/red pair is done with two mutually-exclusive conditional
          # cards - exactly one renders. They live in a vertical-stack per
          # account so the hidden one can't collapse the row's columns.
          #
          # Each halts ONLY its own account; the global "halt everything" is
          # CLI-only by design (flatten.py --halt --all-accounts), so nothing
          # here can stop the judged account.
          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  # Trading (switch off) -> GREEN. Tap halts, with a confirm.
                  - type: conditional
                    conditions:
                      - condition: state
                        entity: switch.alpaca_{{ acct.id }}_kill_switch
                        state: "off"
                    card:
                      type: tile
                      entity: switch.alpaca_{{ acct.id }}_kill_switch
                      name: {{ acct.label }} — trading
                      icon: mdi:play-circle
                      color: green
                      hide_state: true
                      tap_action:
                        action: toggle
                        confirmation:
                          text: >-
                            Flatten {{ acct.label }}'s positions and halt
                            {{ acct.label }}? Other accounts keep trading.
                  # Halted (switch on) -> RED. Tap resumes, with a confirm.
                  # A daily-loss or global halt also shows red here, but the
                  # bridge refuses to clear those from the dashboard and
                  # republishes the real state, so the tile stays red.
                  - type: conditional
                    conditions:
                      - condition: state
                        entity: switch.alpaca_{{ acct.id }}_kill_switch
                        state: "on"
                    card:
                      type: tile
                      entity: switch.alpaca_{{ acct.id }}_kill_switch
                      name: {{ acct.label }} — HALTED
                      icon: mdi:stop-circle
                      color: red
                      hide_state: true
                      tap_action:
                        action: toggle
                        confirmation:
                          text: >-
                            Resume trading on {{ acct.label }}? This only
                            clears a manual halt - a daily-loss or global
                            halt still has to be cleared on the host.
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  - type: heading
                    heading: {{ acct.label }}
                    icon: mdi:robot
                  - type: entities
                    title: State
                    entities:
                      - entity: sensor.alpaca_{{ acct.id }}_equity
                        name: Equity
                      - entity: sensor.alpaca_{{ acct.id }}_day_pnl
                        name: Day P&L
                      - entity: sensor.alpaca_{{ acct.id }}_positions
                        name: Open positions
                      - entity: sensor.alpaca_{{ acct.id }}_halt
                        name: Halt state
                      - entity: sensor.alpaca_{{ acct.id }}_last_decision
                        name: Last decision
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: history-graph
                title: {{ acct.label }} — Day P&L
                hours_to_show: 24
                entities:
                  - entity: sensor.alpaca_{{ acct.id }}_day_pnl
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: entities
                title: {{ acct.label }} — controls
                entities:
                  - entity: text.alpaca_{{ acct.id }}_model
                    name: Model
                  - entity: number.alpaca_{{ acct.id }}_temperature
                    name: Temperature
                  - entity: number.alpaca_{{ acct.id }}_max_tokens
                    name: Max tokens
                  - entity: number.alpaca_{{ acct.id }}_research_contracts_per_underlying
                    name: Research contracts/underlying
                  - entity: number.alpaca_{{ acct.id }}_option_strike_band_pct
                    name: Strike band %
                  - entity: number.alpaca_{{ acct.id }}_stop_loss_pct
                    name: Stop loss %
                  - entity: number.alpaca_{{ acct.id }}_take_profit_pct
                    name: Take profit %
                  - entity: number.alpaca_{{ acct.id }}_eod_close_dte
                    name: EOD close DTE
{% endfor %}
