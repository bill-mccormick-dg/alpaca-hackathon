# {{ ansible_managed }}
# Home Assistant YAML-mode dashboard for the alpaca-hackathon bot(s).
# Entities come from two publishers: bot/mqtt.py (the read-only state
# sensors, published by run_cycle.py each cycle) and mqtt_bridge.py (the
# kill-switch button + tunable-knob controls, published once at bridge
# startup - see mqtt_bridge.py's discovery_payloads()). Row 1 is the
# intro (full width), row 2 each account's State side by side, row 3
# each account's Day P&L history side by side, row 4 each account's
# controls (kill switch + knobs) side by side. The cross-account equity
# comparison chart is deliberately left off for now.
title: {{ ha_dashboard_title }}
views:
  - title: Trading
    path: {{ ha_dashboard_url_path }}
    icon: {{ ha_dashboard_icon }}
    type: panel
    cards:
      - type: vertical-stack
        cards:
          - type: markdown
            content: >
              Long Premium, Short Leash — deterministic risk gates, an
              open-source model proposes, code disposes. Source:
              [alpaca-hackathon](https://github.com/bill-mccormick-dg/alpaca-hackathon).

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  - type: heading
                    heading: {{ acct.label }}
                    icon: mdi:robot
                  - type: entities
                    title: State
                    entities:
                      - entity: sensor.alpaca_{{ acct.id }}_equity
                        name: Equity
                      - entity: sensor.alpaca_{{ acct.id }}_day_pnl
                        name: Day P&L
                      - entity: sensor.alpaca_{{ acct.id }}_positions
                        name: Open positions
                      - entity: sensor.alpaca_{{ acct.id }}_halt
                        name: Halt state
                      - entity: sensor.alpaca_{{ acct.id }}_last_decision
                        name: Last decision
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: history-graph
                title: {{ acct.label }} — Day P&L
                hours_to_show: 24
                entities:
                  - entity: sensor.alpaca_{{ acct.id }}_day_pnl
{% endfor %}

          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  # A kill switch should be hard to fire by accident and easy
                  # to fire on purpose. tile (one compact row) instead of a
                  # big button card, and HOLD-to-fire rather than tap: a
                  # stray tap does nothing at all, a deliberate press-and-hold
                  # raises the confirm dialog. Two deliberate steps.
                  # It halts ONLY this account - the global "halt everything"
                  # is CLI-only by design (flatten.py --halt --all-accounts),
                  # so nothing on this dashboard can stop the judged account.
                  - type: tile
                    entity: button.alpaca_{{ acct.id }}_kill_switch
                    name: Kill switch — hold to fire
                    icon: mdi:stop-octagon
                    color: red
                    hide_state: true
                    tap_action:
                      action: none
                    hold_action:
                      action: perform-action
                      perform_action: button.press
                      target:
                        entity_id: button.alpaca_{{ acct.id }}_kill_switch
                      confirmation:
                        text: >-
                          Flatten {{ acct.label }}'s positions and halt
                          {{ acct.label }}? Other accounts keep trading. A
                          human has to delete
                          logs/HALT_manual{{ '_' ~ acct.id if acct.id != 'official' else '' }}
                          on the trading host to resume.
                  - type: entities
                    title: Controls
                    entities:
                      - entity: text.alpaca_{{ acct.id }}_model
                        name: Model
                      - entity: number.alpaca_{{ acct.id }}_temperature
                        name: Temperature
                      - entity: number.alpaca_{{ acct.id }}_max_tokens
                        name: Max tokens
                      - entity: number.alpaca_{{ acct.id }}_research_contracts_per_underlying
                        name: Research contracts/underlying
                      - entity: number.alpaca_{{ acct.id }}_option_strike_band_pct
                        name: Strike band %
                      - entity: number.alpaca_{{ acct.id }}_stop_loss_pct
                        name: Stop loss %
                      - entity: number.alpaca_{{ acct.id }}_take_profit_pct
                        name: Take profit %
                      - entity: number.alpaca_{{ acct.id }}_eod_close_dte
                        name: EOD close DTE
{% endfor %}
