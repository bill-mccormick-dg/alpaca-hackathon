{% raw %}{% endraw %}# {{ ansible_managed }}
# READ-ONLY dashboard for remote teammates (issue #87). Reached over
# Tailscale; see ansible/README.md "Remote team access".
#
# THE RULE FOR THIS FILE: it must contain no `switch.` and no `button.`
# entity anywhere, ever. Home Assistant has no per-entity permissions for
# non-admin users - anything rendered on a dashboard they can open, they can
# operate. The kill switches therefore live only on the operational
# dashboard (dashboard.yaml.j2), which must be marked admin-only when this
# one is in use. Adding a control here silently hands every teammate the
# ability to halt a live trading account.
#
# Entity ids follow bot/mqtt.py's ENTITY_PREFIX scheme
# (<prefix>_<account>_<key>); tests/test_mqtt.py::EntityIdDerivationTest
# pins the naming that produces them, including the two attribute-carrying
# report sensors used below.
title: {{ ha_team_dashboard_title }}
views:
  - title: Today
    path: {{ ha_team_dashboard_url_path }}
    icon: {{ ha_team_dashboard_icon }}
    type: panel
    cards:
      - type: vertical-stack
        cards:
          - type: markdown
            content: >-
              ## {{ ha_team_dashboard_title }}

              Read-only view of the trading agent. Nothing here can change
              what the bot does. Updated every cycle (10 min) during market
              hours; the end-of-day digest lands after the close.

          # --- per-account state, one column each ------------------------
          - type: horizontal-stack
            cards:
{% for acct in ha_accounts %}
              - type: vertical-stack
                cards:
                  - type: entities
                    title: {{ acct.label }}
                    entities:
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_equity
                        name: Equity
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_day_pnl
                        name: Day P&L
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_positions
                        name: Open positions
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_halt
                        name: Halt state
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_last_decision
                        name: Last decision
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_recent_trades
                        name: Today
                  - type: history-graph
                    title: {{ acct.label }} — equity
                    hours_to_show: 24
                    entities:
                      - entity: sensor.{{ ha_entity_prefix }}_{{ acct.id }}_equity
{% endfor %}

          # --- intra-day trade log ---------------------------------------
          # The markdown rides in a JSON attribute because HA caps a
          # sensor's state at 255 characters - see bot/report.py.
{% for acct in ha_accounts %}
          - type: markdown
            title: {{ acct.label }} — trades today
            content: >-
              {% raw %}{{ state_attr('sensor.{% endraw %}{{ ha_entity_prefix }}_{{ acct.id }}_recent_trades{% raw %}', 'markdown') or '_Waiting for the first cycle._' }}{% endraw %}
{% endfor %}

          # --- end-of-day digest -----------------------------------------
{% for acct in ha_accounts %}
          - type: markdown
            title: {{ acct.label }} — end of day
            content: >-
              {% raw %}{{ state_attr('sensor.{% endraw %}{{ ha_entity_prefix }}_{{ acct.id }}_eod_summary{% raw %}', 'markdown') or '_No digest yet today._' }}{% endraw %}
{% endfor %}
