__pycache__/
*.pyc
# Local dev credentials. secrets.yaml is the canonical one; .env/.env.<name>
# are the legacy form, still read by bot/credentials.py for back-compat.
secrets.yaml
.env
.env.*
.DS_Store
logs/
docs-site/node_modules/
docs-site/build/
docs-site/.docusaurus/
ansible/inventory.ini
# Stand-ins uploaded to the lablab.ai form early so the submission can be
# completed before the real artifacts exist. Both carry a visible
# PLACEHOLDER band and are replaced before the deadline - they are build
# output, not sources, so they stay out of the repo.
submission/slides-placeholder.pdf
submission/video/placeholder.*
# The video is assembled from parts (submission/video/assemble.py). These three
# are inputs or output, not sources: build/ and the generated tapes are
# reproducible from slides.pdf, demo.sh and cuts.txt, and footage/ is 46MB of
# screen recording that gets redone whenever the screen changes.
#
# narration/ is deliberately NOT here. A voice take is the one part of this that
# cannot be regenerated from anything in the repo, and it is a few megabytes.
submission/video/build/
submission/video/footage/
submission/video/tapes/generated/

# Scratch record of other teams's repos (rival_repos.py) - not part of the submission.
submission/rival-repos.json
submission/rival-urls.txt
submission/rival-survey.md
submission/rival-report.html
submission/rival-report.pdf
